<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- Label of the multiplayer entry in the top bar of the launcher main screen -->
    <string name="terracotta">Multiplayer</string>
    <!-- Footer of the in-game multiplayer menu dialog; %s is the Terracotta core version -->
    <string name="terracotta_metadata_ver">Terracotta Version: %s</string>
    <!-- Footer of the in-game multiplayer menu dialog; %s is the EasyTier core version -->
    <string name="terracotta_metadata_easytier_ver">EasyTier Version: %s</string>
    <!-- Card on the multiplayer settings page that opens the EasyTier website -->
    <string name="terracotta_easytier">About EasyTier</string>
    <!-- Title of the multiplayer screen; also the name of the Terracotta VPN notification channel -->
    <string name="terracotta_terracotta">Terracotta | Multiplayer</string>
    <!-- Title of the exit button in the in-game multiplayer menu dialog -->
    <string name="terracotta_back">Exit</string>
    <!-- Switch on the multiplayer settings page that enables the multiplayer feature -->
    <string name="terracotta_enable">Enable Multiplayer</string>
    <!-- Connection quality estimate (excellent) shown while joining a room as a guest -->
    <string name="terracotta_difficulty_easiest">Excellent network: almost connected!</string>
    <!-- Connection quality estimate (good) shown while joining a room as a guest -->
    <string name="terracotta_difficulty_simple">Good network: connection may take some time…</string>
    <!-- Connection quality estimate (average) shown while joining a room as a guest -->
    <string name="terracotta_difficulty_medium">Average network: enabling fallback routes, though connection may fail</string>
    <!-- Connection quality estimate (poor) shown while joining a room as a guest -->
    <string name="terracotta_difficulty_tough">Poor network: enabling fallback routes, though connection may fail</string>
    <!-- Disclaimer under the connection quality estimate while joining a room as a guest -->
    <string name="terracotta_difficulty_estimate_only">Success rate is an estimate based on host and client NAT types, for reference only!</string>
    <!-- Button in the in-game multiplayer menu that opens the multiplayer core log view -->
    <string name="terracotta_log">View Logs</string>
    <!-- Description of the exit button below the log view in the in-game multiplayer menu -->
    <string name="terracotta_log_exit">Close the log and return to the feature page.</string>
    <!-- Hint on the connection lost page of the multiplayer menu to share logs for error analysis -->
    <string name="terracotta_export_log">You can share logs on the launcher\'s multiplayer page to provide more information for error analysis.</string>
    <!-- Card on the multiplayer settings page that shares the multiplayer core log file -->
    <string name="terracotta_export_log_share">Share Multiplayer Core log</string>
    <!-- Toast on the multiplayer settings page when there is no log file to share -->
    <string name="terracotta_export_log_share_null">No log found</string>
    <!-- Dialog text when enabling multiplayer for the first time, where you promise to obey local laws -->
    <string name="terracotta_status_uninitialized_desc">You legally promise to strictly abide by all laws and regulations of your country or region during the multiplayer process.</string>
    <!-- Tab of the multiplayer tutorial page that shows the user notice -->
    <string name="terracotta_confirm_title">User Notice</string>
    <!-- Paragraph in the multiplayer user notice about Terracotta being free open source software -->
    <string name="terracotta_confirm_software">Terracotta is a third-party open source free software. Please provide feedback on any issues you encounter through the relevant channels during use.</string>
    <!-- Paragraph in the multiplayer user notice explaining the peer-to-peer technology -->
    <string name="terracotta_confirm_p2p">Terracotta uses P2P technology. After a successful connection, users in the room will connect directly to each other, and no third-party server will relay your traffic. The final multiplayer experience largely depends on the network conditions of the participants.</string>
    <!-- Paragraph in the multiplayer user notice about obeying the laws of your country or region -->
    <string name="terracotta_confirm_law">During the entire multiplayer process, you must strictly comply with all laws and regulations of your country and region.</string>
    <!-- Switch on the multiplayer settings page that enables custom EasyTier server nodes -->
    <string name="terracotta_custom_note_list">Custom EasyTier Server Nodes</string>
    <!-- Label of the custom EasyTier server nodes input field on the multiplayer settings page -->
    <string name="terracotta_custom_note_list_hint">Leave empty to use default nodes</string>
    <!-- Button in the in-game menu that opens the multiplayer menu; also that menu dialog's title -->
    <string name="terracotta_menu">Multiplayer Menu</string>
    <!-- Title of the persistent notification shown while the multiplayer VPN is running -->
    <string name="terracotta_notification_title">Terracotta | Multiplayer Running</string>
    <!-- Content of the multiplayer VPN notification; first %s is the role (host/guest), second %s is the state -->
    <string name="terracotta_notification_desc">Identity: %s, State: %s</string>
    <!-- Content of the multiplayer VPN notification while the connection is being prepared -->
    <string name="terracotta_notification_state_preparing">Preparing connection…</string>
    <!-- Card in the multiplayer menu for choosing to host a game session -->
    <string name="terracotta_status_waiting_host_title">I want to host a session</string>
    <!-- Description of the host card in the multiplayer menu -->
    <string name="terracotta_status_waiting_host_desc">Create a room and generate an invite code to play with friends</string>
    <!-- Card in the multiplayer menu for choosing to join a game session -->
    <string name="terracotta_status_waiting_guest_title">I want to join a session</string>
    <!-- Description of the guest card in the multiplayer menu -->
    <string name="terracotta_status_waiting_guest_desc">Enter the invite code from the host player to join the game world</string>
    <!-- Title of the dialog where a guest enters the invite code -->
    <string name="terracotta_status_waiting_guest_prompt_title">Please enter the invite code from the host</string>
    <!-- Error shown when the entered invite code is not recognized, below the input field and as a toast -->
    <string name="terracotta_status_waiting_guest_prompt_invalid">Invalid invite code</string>
    <!-- Hint below the invite code field recognizing a legacy Terracotta invite code -->
    <string name="terracotta_status_waiting_guest_prompt_terracotta_legacy">Legacy Terracotta Invite Code</string>
    <!-- Hint below the invite code field recognizing a legacy PCL CE invite code -->
    <string name="terracotta_status_waiting_guest_prompt_pcl2ce">Legacy PCL CE Invite Code</string>
    <!-- Hint below the invite code field recognizing a Scaffolding invite code -->
    <string name="terracotta_status_waiting_guest_prompt_scaffolding">Scaffolding Invite Code</string>
    <!-- Progress title in the multiplayer menu while scanning for a LAN world as host -->
    <string name="terracotta_status_host_scanning">Scanning LAN worlds</string>
    <!-- Instruction under the LAN world scanning progress in the multiplayer menu -->
    <string name="terracotta_status_host_scanning_desc">Please open a world, press ESC, select "Open to LAN", then select "Start LAN World".</string>
    <!-- Description of the exit button shown while scanning for a LAN world -->
    <string name="terracotta_status_host_scanning_back">This will also stop scanning LAN worlds.</string>
    <!-- Progress title in the multiplayer menu while the host room is being created -->
    <string name="terracotta_status_host_starting">Room Creating</string>
    <!-- Description of the exit button shown while the host room is being created -->
    <string name="terracotta_status_host_starting_back">This will stop creating the room.</string>
    <!-- Success text in the multiplayer menu once the host room is created -->
    <string name="terracotta_status_host_ok">Room created</string>
    <!-- Label above the invitation code in the room created view of the multiplayer menu -->
    <string name="terracotta_status_host_ok_code">Invitation code (Copied): </string>
    <!-- Button in the multiplayer menu to copy the invitation code after the room is created -->
    <string name="terracotta_status_host_ok_code_copy">Copy invitation code</string>
    <!-- Toast confirming the invitation code was copied to the clipboard -->
    <string name="terracotta_status_host_ok_code_copy_toast">Invitation code has been copied to clipboard</string>
    <!-- Description of the copy invitation code button, reminding friends to enter the code as guests -->
    <string name="terracotta_status_host_ok_code_desc">Please remind your friends to select Guest mode in the multiplayer feature and enter this invitation code.</string>
    <!-- Warning on the exit button after the room is created, saying the room closes and guests cannot rejoin -->
    <string name="terracotta_status_host_ok_back">This will also close the room, other guests will leave and cannot rejoin.</string>
    <!-- Progress title in the multiplayer menu while joining a room as guest -->
    <string name="terracotta_status_guest_starting">Joining room</string>
    <!-- Description of the exit button shown while joining a room as a guest -->
    <string name="terracotta_status_guest_starting_back">This will not stop other guests from joining the room.</string>
    <!-- Success text in the multiplayer menu once the room is joined as guest -->
    <string name="terracotta_status_guest_ok">Room Joined</string>
    <!-- Description on the exit button after joining, saying leaving does not stop other guests -->
    <string name="terracotta_status_guest_ok_back">This will not stop other guests from joining the room.</string>
    <!-- Instruction for the guest after joining, telling how to enter the lobby; ends with a backup address -->
    <string name="terracotta_status_guest_ok_address">Please launch the game, select Multiplayer, and double-click Terracotta Lobby. Backup address: </string>
    <!-- Button in the multiplayer menu to copy the backup server address after joining as guest -->
    <string name="terracotta_status_guest_ok_address_copy">Copy Backup address</string>
    <!-- Toast confirming the backup address was copied to the clipboard -->
    <string name="terracotta_status_guest_ok_address_copy_toast">Backup address has been copied to clipboard</string>
    <!-- Description of the copy backup address button, advising to avoid using it unless necessary -->
    <string name="terracotta_status_guest_ok_address_desc">Please do not use this address unless necessary.</string>
    <!-- Error title in the multiplayer menu when the connection is lost -->
    <string name="terracotta_status_exception">Connection lost</string>
    <!-- Description of the exit button on the connection lost page of the multiplayer menu -->
    <string name="terracotta_status_exception_back">Please try again</string>
    <!-- Error title in the multiplayer menu when joining failed because the room is closed or network unstable -->
    <string name="terracotta_status_exception_desc_ping_host_fail">Failed to join room: Room is closed or network unstable</string>
    <!-- Error title in the multiplayer menu when the connection dropped because the room closed or network unstable -->
    <string name="terracotta_status_exception_desc_ping_host_rst">Room connection lost: Room is closed or network unstable</string>
    <!-- Error title in the multiplayer menu when joining failed because EasyTier crashed -->
    <string name="terracotta_status_exception_desc_guest_et_crash">Failed to join room: EasyTier crashed, please report this issue to developers</string>
    <!-- Error title in the multiplayer menu when room creation failed because EasyTier crashed -->
    <string name="terracotta_status_exception_desc_host_et_crash">Failed to create room: EasyTier crashed, please report this issue to developers</string>
    <!-- Error title in the multiplayer menu when the room closed after you exited the game world -->
    <string name="terracotta_status_exception_desc_ping_server_rst">Room closed: You exited the game world, room closed automatically</string>
    <!-- Error title in the multiplayer menu when the host sent an invalid protocol response -->
    <string name="terracotta_status_exception_desc_scaffolding_invalid_response">Invalid Protocol: Host has sent invalid response, please report this issue to developers</string>
    <!-- Toast asking the user to grant VPN permission before using multiplayer -->
    <string name="terracotta_permission_vpn">Please grant the application VPN permission first.</string>
    <!-- Heading of the player list shown beside the room view in the multiplayer menu -->
    <string name="terracotta_player_list">Player List</string>
    <!-- Fallback name in the room player list for a player without a name -->
    <string name="terracotta_player_anonymous">Anonymous Player</string>
    <!-- Tag after a player name in the room player list marking the host; also used in the VPN notification -->
    <string name="terracotta_player_kind_host">Host</string>
    <!-- Tag after a player name in the room player list marking yourself -->
    <string name="terracotta_player_kind_local">Yourself</string>
    <!-- Tag after a player name in the room player list marking a guest; also used in the VPN notification -->
    <string name="terracotta_player_kind_guest">Guest</string>
    <!-- Tab of the multiplayer tutorial page showing the host guide -->
    <string name="terracotta_tutorial_host_tab">Host Tutorial</string>
    <!-- Tab of the multiplayer tutorial page showing the guest guide -->
    <string name="terracotta_tutorial_guest_tab">Guest Tutorial</string>
    <!-- Heading of the steps list in the host tutorial -->
    <string name="terracotta_tutorial_host_tip">Host Tutorial:</string>
    <!-- Heading of the steps list in the guest tutorial -->
    <string name="terracotta_tutorial_guest_tip">Guest Tutorial:</string>
    <!-- Step in the multiplayer tutorial: enable multiplayer on the launcher homepage after the user notice -->
    <string name="terracotta_tutorial_step_enable_multiplayer">- Enable multiplayer in the launcher homepage after reading the user notice</string>
    <!-- Step in the multiplayer tutorial: launch the game and open the in-game multiplayer menu -->
    <string name="terracotta_tutorial_step_open_multiplayer_menu">- Launch the game, then find and open the multiplayer menu in-game</string>
    <!-- Step in the multiplayer tutorial: allow the VPN permission prompt when it appears -->
    <string name="terracotta_tutorial_step_vpn_permission">- If prompted to grant VPN permission, allow it; otherwise it will not function properly</string>
    <!-- Note in the multiplayer tutorial: offline accounts are supported -->
    <string name="terracotta_tutorial_step_offline_account_support">- This software supports offline accounts</string>
    <!-- Note in the multiplayer tutorial: works with FCL, HMCL and PCL CE via the Scaffolding protocol -->
    <string name="terracotta_tutorial_step_interoperability">- This software supports interoperability with software such as FCL, HMCL, and PCL CE (Terracotta) that support the Scaffolding protocol</string>
    <!-- Step in the host tutorial: tap the host card and scan the game port -->
    <string name="terracotta_tutorial_host_step_become_host">- Tap "I want to host a session" and scan the game port</string>
    <!-- Step in the host tutorial: open the world to LAN from the game pause menu -->
    <string name="terracotta_tutorial_host_step_open_lan">- Enter your world and enable "Open to LAN" in the pause menu</string>
    <!-- Step in the host tutorial: wait for the invite code and copy it automatically -->
    <string name="terracotta_tutorial_host_step_copy_invite">- Wait a moment for the invite code to be copied automatically; if not, you can copy it from the multiplayer menu</string>
    <!-- Step in the host tutorial: send the invite code to your friends -->
    <string name="terracotta_tutorial_host_step_send_invite">- Send the invite code to your friends</string>
    <!-- Step in the guest tutorial: tap the guest card, enter the host invite code and wait -->
    <string name="terracotta_tutorial_guest_step_become_guest">- Tap "I want to join a session", enter the invite code provided by the host, and wait patiently</string>
    <!-- Step in the guest tutorial: join the Terracotta lobby from the game multiplayer menu -->
    <string name="terracotta_tutorial_guest_step_join_room">- After joining the room, go to Multiplayer in the main menu, refresh, and double-click to enter the Terracotta lobby</string>
    <!-- Note in the guest tutorial: offline accounts do not work when joining via alternate addresses -->
    <string name="terracotta_tutorial_guest_step_alternate_server">- Offline accounts are not supported when joining via alternate server addresses; resolve this yourself</string>
    <!-- Heading of the notes section in the multiplayer tutorials -->
    <string name="terracotta_tutorial_note_title">Notes:</string>
</resources>
